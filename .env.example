# Supabase Credentials Configuration
# Copy this file to .env and fill in your details.

# Your Supabase Project API URL (found under Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Project API Key (use service_role key to bypass Row Level Security)
SUPABASE_KEY=your-supabase-service-role-key

# The name of the Supabase Public Storage bucket you created for screenshots (e.g. screenshots)
SUPABASE_BUCKET=screenshots
